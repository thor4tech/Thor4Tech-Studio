rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    
    function getUserRole() {
      let isUserDocExist = exists(/databases/$(database)/documents/users/$(request.auth.uid));
      return isUserDocExist ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : '';
    }
    
    function isAdmin() { 
      // thor4tech@gmail.com is hardcoded admin
      return isSignedIn() && (request.auth.token.email == 'thor4tech@gmail.com' || getUserRole() == 'admin'); 
    }

    function isEditor() {
      return isSignedIn() && getUserRole() == 'editor';
    }

    function isViewer() {
      return isSignedIn() && getUserRole() == 'viewer';
    }

    function getMyClients() {
      let docData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return ('client_ids' in docData) ? docData.client_ids : [];
    }

    // Admins see all, Viewers see if clientId is in their array
    function canViewClient(clientId) {
      return isAdmin() || (isViewer() && (clientId in getMyClients()));
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin();
      allow create: if isAdmin() || (request.auth.uid == userId && request.auth.token.email == 'thor4tech@gmail.com');
      allow delete: if isAdmin();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isSignedIn() && canViewClient(clientId);
      allow create, update, delete: if isAdmin();
    }

    // Videos
    match /videos/{videoId} {
      // List/read logic:
      allow read: if isSignedIn() && (
        isAdmin() || 
        (isEditor() && resource.data.editor_id == request.auth.uid) ||
        (isViewer() && (resource.data.client_id in getMyClients()))
      );
      
      allow create: if isAdmin();
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isEditor() && existing().editor_id == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'versions', 'updated_at'])) ||
        (isViewer() && canViewClient(existing().client_id) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updated_at']))
      );
      
      allow delete: if isAdmin();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if isSignedIn(); // We rely on query filtering client side, though could be optimized
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (existing().author_id == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (existing().author_id == request.auth.uid || isAdmin());
    }

    // Pipeline Logs
    match /pipeline_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}
